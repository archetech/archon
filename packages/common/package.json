{
  "name": "@didcid/common",
  "version": "0.4.0",
  "description": "Archon common utilities",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils.js",
      "require": "./dist/cjs/utils.cjs",
      "types": "./dist/types/utils.d.ts"
    },
    "./errors": {
      "import": "./dist/esm/errors.js",
      "require": "./dist/cjs/errors.cjs",
      "types": "./dist/types/errors.d.ts"
    },
    "./net": {
      "types": "./dist/types/net.d.ts",
      "browser": {
        "import": "./dist/esm/net.js",
        "require": "./dist/cjs/net.cjs"
      },
      "node": {
        "import": "./dist/esm/net-node.js",
        "require": "./dist/cjs/net-node.cjs"
      },
      "import": "./dist/esm/net.js",
      "require": "./dist/cjs/net.cjs"
    },
    "./process-guards": {
      "import": "./dist/esm/process-guards.js",
      "require": "./dist/cjs/process-guards.cjs",
      "types": "./dist/types/process-guards.d.ts"
    },
    "./net-node": {
      "import": "./dist/esm/net-node.js",
      "require": "./dist/cjs/net-node.cjs",
      "types": "./dist/types/net-node.d.ts"
    },
    "./tor-node": {
      "import": "./dist/esm/tor-node.js",
      "require": "./dist/cjs/tor-node.cjs",
      "types": "./dist/types/tor-node.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/types/utils.d.ts"
      ],
      "errors": [
        "./dist/types/errors.d.ts"
      ],
      "net": [
        "./dist/types/net.d.ts"
      ],
      "process-guards": [
        "./dist/types/process-guards.d.ts"
      ],
      "net-node": [
        "./dist/types/net-node.d.ts"
      ],
      "tor-node": [
        "./dist/types/tor-node.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.json",
    "bundle:cjs": "rollup -c rollup.cjs.config.js",
    "build": "npm run clean && npm run build:esm && npm run bundle:cjs"
  },
  "keywords": [],
  "author": "David McFadzean <davidmc@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archetech/archon.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "rollup": "^4.63.3"
  },
  "dependencies": {
    "socks": "^2.8.7",
    "undici": "^6.28.0"
  }
}
