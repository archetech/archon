{
  "name": "@didcid/ipfs",
  "version": "0.3.3",
  "description": "Archon IPFS lib",
  "type": "module",
  "module": "./dist/esm/index.js",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/esm/index.js",
        "types": "./dist/types/index.d.ts"
      },
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.cjs",
        "types": "./dist/types/node.d.ts"
      },
      "default": {
        "import": "./dist/esm/node.js",
        "types": "./dist/types/node.d.ts"
      }
    },
    "./kubo": {
      "import": "./dist/esm/kubo-client.js",
      "require": "./dist/cjs/kubo-client.cjs",
      "types": "./dist/types/kubo-client.d.ts"
    },
    "./memory": {
      "import": "./dist/esm/memory-client.js",
      "require": "./dist/cjs/memory-client.cjs",
      "types": "./dist/types/memory-client.d.ts"
    },
    "./utils": {
      "import": "./dist/esm/utils.js",
      "require": "./dist/cjs/utils.cjs",
      "types": "./dist/types/utils.d.ts"
    },
    "./types": {
      "types": "./dist/types/types.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "kubo": [
        "./dist/types/kubo-client.d.ts"
      ],
      "memory": [
        "./dist/types/memory-client.d.ts"
      ],
      "utils": [
        "./dist/types/utils.d.ts"
      ],
      "types": [
        "./dist/types/types.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.json",
    "bundle:cjs": "rollup -c rollup.cjs.config.js",
    "build": "npm run clean && npm run build:esm && npm run bundle:cjs"
  },
  "keywords": [],
  "author": "David McFadzean <davidmc@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@didcid/common": "^0.3.3",
    "axios": "^1.19.0",
    "ip": "^2.0.1",
    "kubo-rpc-client": "^5.1.0",
    "multiformats": "^13.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archetech/archon.git"
  },
  "devDependencies": {
    "@types/ip": "^1.1.3"
  }
}
