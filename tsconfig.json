{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "sourceMap": true,
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "inlineSourceMap": false,
    "inlineSources": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@didcid/clients": [
        "packages/clients/src/index.ts"
      ],
      "@didcid/clients/gatekeeper": [
        "packages/clients/src/gatekeeper-client.ts"
      ],
      "@didcid/clients/drawbridge": [
        "packages/clients/src/drawbridge-client.ts"
      ],
      "@didcid/clients/keymaster": [
        "packages/clients/src/keymaster-client.ts"
      ],
      "@didcid/clients/gatekeeper-types": [
        "packages/clients/src/gatekeeper-types.ts"
      ],
      "@didcid/clients/keymaster-types": [
        "packages/clients/src/keymaster-types.ts"
      ],
      "@didcid/cipher/node": [
        "packages/cipher/src/cipher-node.ts"
      ],
      "@didcid/cipher/web": [
        "packages/cipher/src/cipher-web.ts"
      ],
      "@didcid/cipher/types": [
        "packages/cipher/src/types.ts"
      ],
      "@didcid/browser-hdkey": [
        "packages/browser-hdkey/lib/hdkey.js"
      ],
      "@didcid/common/errors": [
        "packages/common/src/errors.ts"
      ],
      "@didcid/common/utils": [
        "packages/common/src/utils.ts"
      ],
      "@didcid/gatekeeper": [
        "packages/gatekeeper/src/gatekeeper.ts"
      ],
      "@didcid/gatekeeper/types": [
        "packages/gatekeeper/src/types.ts"
      ],
      "@didcid/gatekeeper/client": [
        "packages/gatekeeper/src/gatekeeper-client.ts"
      ],
      "@didcid/gatekeeper/db/*": [
        "packages/gatekeeper/src/db/*"
      ],
      "@didcid/ipfs/helia": [
        "packages/ipfs/src/helia-client.ts"
      ],
      "@didcid/ipfs/utils": [
        "packages/ipfs/src/utils.ts"
      ],
      "@didcid/keymaster": [
        "packages/keymaster/src/keymaster.ts"
      ],
      "@didcid/keymaster/client": [
        "packages/keymaster/src/keymaster-client.ts"
      ],
      "@didcid/keymaster/types": [
        "packages/keymaster/src/types.ts"
      ],
      "@didcid/cipher/passphrase": [
        "packages/cipher/src/passphrase.ts"
      ],
      "@didcid/keymaster/search": [
        "packages/keymaster/src/search-client.ts"
      ],
      "@didcid/keymaster/wallet/*": [
        "packages/keymaster/src/db/*"
      ],
      "@didcid/mcp-server": [
        "packages/mcp-server/src/index.ts"
      ],
      // Each service carries its own @types/express, so an app built from the
      // root copy and a Router built from a service copy are different nominal
      // types and `app.use(path, router)` has no matching overload. Pinning the
      // express types to one copy makes the whole program agree.
      "express": [
        "node_modules/@types/express"
      ],
      "express-serve-static-core": [
        "node_modules/@types/express-serve-static-core"
      ]
    }
  },
  "include": [
    "tests/**/*.ts",
    // Ambient declarations belonging to the services the tests import: module
    // shims for untyped packages, and the express-session augmentation herald
    // relies on. They are not reachable through an import, so without naming
    // them here the program reports errors the services themselves have
    // already answered.
    "services/**/src/declarations.d.ts",
    "services/**/src/express.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
