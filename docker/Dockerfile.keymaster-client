# Use the official Node.js as the base image
FROM node:22.15.0-bookworm-slim

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json to the working directory
COPY package*.json ./
COPY packages/ ./packages/

# Seed prebuild-install with natively-fetched binaries (scripts/prefetch-prebuilds.mjs).
# Empty in local builds, which falls back to prebuild-install's network fetch.
COPY prebuilds/ /prebuilds/
ENV npm_config_sqlite3_local_prebuilds=/prebuilds \
    npm_config_ipshipyard_node_datachannel_local_prebuilds=/prebuilds

# Install dependencies
RUN npm ci
RUN npm run build

COPY apps/keymaster-client ./apps/keymaster-client/

WORKDIR /app/apps/keymaster-client

RUN npm ci

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

ARG VITE_SERVER_PORT=4226
ENV VITE_SERVER_PORT=$VITE_SERVER_PORT

RUN npm run build

ENV VITE_PORT=4227
EXPOSE 4227

# Run...
CMD ["sh", "-c", "npm run preview -- --host 0.0.0.0 --port ${VITE_PORT}"]
