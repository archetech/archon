FROM node:22.23.2-trixie-slim AS builder

# ws's optional native accelerators, bufferutil and utf-8-validate, publish no
# linux-arm64 prebuild, so on that architecture they are built from source or
# silently skipped. They are optional, so skipping them is not a build failure --
# it drops frame masking and UTF-8 validation to JS on a service whose RPC is
# websocket-heavy. This is the only mediator with such a dependency; the rest
# install nothing that needs a compiler.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/

# Seed prebuild-install with natively-fetched binaries (scripts/prefetch-prebuilds.mjs).
# Empty in local builds, which falls back to prebuild-install's network fetch.
COPY prebuilds/ /prebuilds/
ENV npm_config_ipshipyard_node_datachannel_local_prebuilds=/prebuilds

RUN npm ci
RUN npm run build

COPY services/mediators/solana ./solana/
WORKDIR /app/solana
RUN npm ci && npm run build

# Drop dev dependencies once everything is compiled.
RUN npm prune --omit=dev \
    && cd /app && npm prune --omit=dev

# The build needs devDependencies and a C++ toolchain; the runtime needs
# neither. Native modules are compiled into node_modules, which is copied
# across, so the compiler does not have to ship with them (#987).
FROM node:22.23.2-trixie-slim

WORKDIR /app

# Only what the process opens at runtime: the pruned dependency trees, the
# compiled output, and the workspace packages they resolve through.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/solana ./solana

WORKDIR /app/solana

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

EXPOSE 4249

CMD ["node", "dist/solana-mediator.js"]
