FROM elementsproject/lightningd:v26.06.10

COPY docker/cln/entrypoint.sh /usr/local/bin/cln-entrypoint
COPY docker/cln/healthcheck.sh /usr/local/bin/cln-healthcheck
RUN chmod 755 /usr/local/bin/cln-entrypoint /usr/local/bin/cln-healthcheck

# A first start after an upgrade migrates the wallet database, and mainnet
# startup loads the whole gossip store, so allow minutes before counting
# failures.
HEALTHCHECK --interval=60s --timeout=30s --start-period=600s --retries=3 \
    CMD ["/usr/local/bin/cln-healthcheck"]

ENTRYPOINT ["/usr/local/bin/cln-entrypoint"]
