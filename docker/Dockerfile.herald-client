FROM node:22.23.2-trixie-slim AS builder

WORKDIR /app/apps/herald-client

COPY apps/herald-client/package*.json ./
# Seed prebuild-install with natively-fetched binaries (scripts/prefetch-prebuilds.mjs).
# Empty in local builds, which falls back to prebuild-install's network fetch.
COPY prebuilds/ /prebuilds/
ENV npm_config_ipshipyard_node_datachannel_local_prebuilds=/prebuilds

RUN npm ci

COPY apps/herald-client ./

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

ARG VITE_API_URL=http://localhost:4230/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# The build tooling stays in the builder. `vite preview`, which these images
# used to run, is documented by Vite as "do not use this as a production server
# as it's not designed for it" -- and needing it at runtime dragged the entire
# dev dependency tree into the image to serve static files (#987).
FROM node:22.23.2-trixie-slim

WORKDIR /app

COPY --from=builder /app/apps/herald-client/build ./dist
COPY scripts/serve-static.mjs ./serve-static.mjs

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

ENV VITE_PORT=4231
EXPOSE 4231

CMD ["sh", "-c", "node serve-static.mjs dist ${VITE_PORT}"]
