# Use the official Node.js as the base image
FROM node:22.23.4-trixie-slim AS builder

# Set the working directory
WORKDIR /app

# Copy package.json and package-lock.json to the working directory
COPY package*.json ./
COPY packages/ ./packages/

# Install dependencies
RUN npm ci
RUN npm run build

COPY services/memepool ./memepool/
WORKDIR /app/memepool
RUN npm ci && npm run build

# The pages, which the service serves beside its API. They use none of the
# repository's packages, so they are built by themselves.
COPY apps/memepool /app/memepool-app/
WORKDIR /app/memepool-app
RUN npm ci && npm run build && cp -r dist /app/memepool/public

WORKDIR /app/memepool

# Drop dev dependencies once everything is compiled.
RUN npm prune --omit=dev \
    && cd /app && npm prune --omit=dev

# The build needs devDependencies; the runtime does not.
FROM node:22.23.4-trixie-slim

WORKDIR /app

# Only what the process opens at runtime: the pruned dependency trees, the
# compiled output, and the workspace packages they resolve through.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/memepool ./memepool

WORKDIR /app/memepool

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

EXPOSE 4237

CMD ["node", "dist/memepool.js"]
