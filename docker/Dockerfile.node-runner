# node-runner: the server and its built client. Neither needs the root
# workspace packages, so only its own directory is copied in.
FROM node:22.23.4-trixie-slim AS builder

WORKDIR /app

COPY services/node-runner ./node-runner/

RUN cd node-runner/server && npm ci && npm run build && npm prune --omit=dev
RUN cd node-runner/client && npm ci && npm run build

# The Docker CLI with its Compose and Buildx plugins, matched to the version
# node-runner is tested with. node-runner runs `docker compose` against the
# node exactly as an operator does.
FROM docker:28.1.1-cli AS docker-cli

FROM node:22.23.4-trixie-slim

# git reads the node's commit, which its image builds are labelled with.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx

WORKDIR /app

COPY --from=builder /app/node-runner/server/package.json ./server/package.json
COPY --from=builder /app/node-runner/server/node_modules ./server/node_modules
COPY --from=builder /app/node-runner/server/dist ./server/dist
COPY --from=builder /app/node-runner/client/dist ./client

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ENV ARCHON_NODE_RUNNER_CLIENT_DIR=/app/client

EXPOSE 4280

CMD ["node", "server/dist/index.js"]
