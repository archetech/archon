# node-runner: the server and its built client. Neither needs the root
# workspace packages, so only its own directory is copied in.
FROM node:22.23.4-trixie-slim AS builder

WORKDIR /app

COPY services/node-runner ./node-runner/

RUN cd node-runner/server && npm ci && npm run build && npm prune --omit=dev
RUN cd node-runner/client && npm ci && npm run build

FROM node:22.23.4-trixie-slim

WORKDIR /app

COPY --from=builder /app/node-runner/server/package.json ./server/package.json
COPY --from=builder /app/node-runner/server/node_modules ./server/node_modules
COPY --from=builder /app/node-runner/server/dist ./server/dist
COPY --from=builder /app/node-runner/client/dist ./client

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT
ENV ARCHON_NODE_RUNNER_CLIENT_DIR=/app/client

EXPOSE 4280

CMD ["node", "server/dist/index.js"]
