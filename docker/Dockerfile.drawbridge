# The build needs devDependencies -- typescript, and the root's for the
# mediators that have no local copy -- but the runtime needs none of them.
# Removing them in a later layer would reclaim nothing, since layers are
# additive, so the install and the prune have to end up in the same image
# without the intermediate state: hence a builder stage that is thrown away
# (#987).
FROM node:22.23.2-trixie-slim AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/

# Seed prebuild-install with natively-fetched binaries (scripts/prefetch-prebuilds.mjs).
# Empty in local builds, which falls back to prebuild-install's network fetch.
COPY prebuilds/ /prebuilds/
ENV npm_config_ipshipyard_node_datachannel_local_prebuilds=/prebuilds

RUN npm ci
RUN npm run build

COPY services/drawbridge ./drawbridge/

RUN cd drawbridge/server && npm ci && npm run build

# Drop dev dependencies once everything is compiled. Done here rather than in
# the runtime stage because it needs the same node_modules layout npm installed.
RUN npm prune --omit=dev \
    && cd drawbridge/server && npm prune --omit=dev

FROM node:22.23.2-trixie-slim

WORKDIR /app

# Only what the process opens at runtime: the pruned dependency trees, the
# compiled output, and the workspace packages they resolve through.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/drawbridge ./drawbridge

WORKDIR /app/drawbridge

ARG GIT_COMMIT=unknown
ENV GIT_COMMIT=$GIT_COMMIT

CMD ["node", "server/dist/drawbridge-api.js"]
