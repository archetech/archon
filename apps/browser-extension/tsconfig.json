{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES6",
    "module": "ES6",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": "./",
    "paths": {
      "@didcid/wallet-ui": ["../../packages/wallet-ui/src/index.ts"],
      "@mui/material": ["./node_modules/@mui/material"],
      "@mui/material/*": ["./node_modules/@mui/material/*"],
      "@mui/icons-material": ["./node_modules/@mui/icons-material"],
      "@mui/icons-material/*": ["./node_modules/@mui/icons-material/*"],
      "@emotion/react": ["./node_modules/@emotion/react"],
      "@emotion/react/*": ["./node_modules/@emotion/react/*"],
      "@emotion/styled": ["./node_modules/@emotion/styled"],
      "@emotion/styled/*": ["./node_modules/@emotion/styled/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  }
}
