{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@didcid/wallet-ui": ["../../packages/wallet-ui/src/index.ts"],
      "@uiw/react-json-view": ["./node_modules/@uiw/react-json-view"],
      "@uiw/react-json-view/*": ["./node_modules/@uiw/react-json-view/*"],
      "qrcode.react": ["./node_modules/qrcode.react"],
      "@mui/lab": ["./node_modules/@mui/lab"],
      "@mui/lab/*": ["./node_modules/@mui/lab/*"],
      "@mui/material": ["./node_modules/@mui/material"],
      "@mui/material/*": ["./node_modules/@mui/material/*"],
      "@mui/icons-material": ["./node_modules/@mui/icons-material"],
      "@mui/icons-material/*": ["./node_modules/@mui/icons-material/*"],
      "@emotion/react": ["./node_modules/@emotion/react"],
      "@emotion/react/*": ["./node_modules/@emotion/react/*"],
      "@emotion/styled": ["./node_modules/@emotion/styled"],
      "@emotion/styled/*": ["./node_modules/@emotion/styled/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
