#!/usr/bin/env bash
set -e
source .env

# Optional second arg selects the gatekeeper implementation. Accepts the same
# values as ARCHON_GATEKEEPER_FLAVOR (ts | rust). If unset, falls back to the
# value already in the environment (e.g. from .env) or "ts".
case "${2:-${ARCHON_GATEKEEPER_FLAVOR:-ts}}" in
  rust)            export ARCHON_GATEKEEPER_FLAVOR="rust" ;;
  ts|typescript)   export ARCHON_GATEKEEPER_FLAVOR="ts" ;;
  *)
    echo "Unknown gatekeeper flavor: ${2:-$ARCHON_GATEKEEPER_FLAVOR} (expected: ts | rust)"
    exit 1
    ;;
esac

# Optional third arg selects the keymaster implementation. Accepts the same
# values as ARCHON_KEYMASTER_FLAVOR (ts | py). If unset, falls back to the
# value already in the environment (e.g. from .env) or "ts".
case "${3:-${ARCHON_KEYMASTER_FLAVOR:-ts}}" in
  py|python)       export ARCHON_KEYMASTER_FLAVOR="py" ;;
  ts|typescript)   export ARCHON_KEYMASTER_FLAVOR="ts" ;;
  *)
    echo "Unknown keymaster flavor: ${3:-$ARCHON_KEYMASTER_FLAVOR} (expected: ts | py)"
    exit 1
    ;;
esac

echo "Using gatekeeper flavor: $ARCHON_GATEKEEPER_FLAVOR"
echo "Using keymaster flavor: $ARCHON_KEYMASTER_FLAVOR"

export GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

echo $ARCHON_GATEKEEPER_URL

# The Cashu integration tests use the node mint through Drawbridge. Its fakewallet
# backend settles quotes without Lightning, and the advertised URL only has to
# be https: Keymaster reaches this mint through its node URL, not that host.
export ARCHON_CASHU_MINT_BACKEND=fakewallet
export ARCHON_CASHU_MINT_URL=http://cashu-mint:8085
export ARCHON_DRAWBRIDGE_PUBLIC_HOST=https://mint.invalid
export ARCHON_KEYMASTER_GATEKEEPER_URL=http://drawbridge:4222

# Locked sends travel through the DIDComm relay. Both identities' mailboxes are on
# this node, so nothing leaves it and no Tor proxy is needed.
export ARCHON_DIDCOMM_URL=http://didcomm:4236
export ARCHON_DIDCOMM_TOR_PROXY=

docker compose down

# These containers run as ARCHON_UID, which need not own the checkout.
mkdir -p data/cashu-mint data/drawbridge
chmod a+rwx data/cashu-mint data/drawbridge

docker compose build cli gatekeeper keymaster ipfs redis mongodb drawbridge didcomm
docker compose up -d cli drawbridge cashu-mint didcomm

echo "Waiting for all services to be 'Up'..."

MAX_RETRIES=30
RETRY_INTERVAL=5
RETRY_COUNT=0

while true; do
  # Which services start depends on the selected profiles, so take the total
  # from the containers compose created rather than a fixed number.
  TOTAL_SERVICES=$(docker compose ps --services | grep -c .)

  # Count lines with 'Up' in status
  UP_COUNT=$(docker compose ps | grep -c 'Up')

  if [[ "$TOTAL_SERVICES" -gt 0 && "$UP_COUNT" -eq "$TOTAL_SERVICES" ]]; then
    echo "✅ All containers are 'Up'"
    break
  fi

  if [[ "$RETRY_COUNT" -ge "$MAX_RETRIES" ]]; then
    echo "❌ Timed out waiting for containers to be 'Up'"
    docker compose ps
    exit 1
  fi

  echo "⏳ Waiting... ($RETRY_COUNT/$MAX_RETRIES)"
  sleep "$RETRY_INTERVAL"
  ((RETRY_COUNT++))
done
