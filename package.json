{
  "name": "archon",
  "version": "0.13.0",
  "type": "module",
  "description": "Self-sovereign identity infrastructure for the decentralized web",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.23.x",
    "npm": "10.9.x"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand --verbose --coverage",
    "test:cli": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cli.js --runInBand --verbose",
    "test:didcomm-e2e": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.didcomm-e2e.js --runInBand --forceExit",
    "generate-openapi": "node swaggerConf.js",
    "lint": "eslint .",
    "build": "npm run build -w @didcid/common && npm run build -w @didcid/ipfs && npm run build -w @didcid/cipher && npm run build -w @didcid/clients && npm run build -w @didcid/gatekeeper && npm run build -w @didcid/keymaster && npm run build -w @didcid/mcp-server",
    "test:wallets": "npm test --prefix apps/react-wallet && npm test --prefix apps/browser-extension"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bitgo/utxo-lib": "^11.22.1",
    "commander": "^11.1.0",
    "sharp": "^0.35.0",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@noble/curves": "^2.3.0",
    "@types/chrome": "^0.2.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/express-session": "^1.19.0",
    "@types/hdkey": "^2.1.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/mock-fs": "^4.13.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.11",
    "@types/supertest": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-sonarjs": "^1.0.4",
    "fetch-socks": "^1.3.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lerna": "^9.0.3",
    "macaroons.js": "^0.3.8",
    "mock-fs": "^5.2.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nock": "^14.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2",
    "yaml": "^2.9.0"
  }
}
