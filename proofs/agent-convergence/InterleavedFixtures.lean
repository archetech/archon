def owner3 : Nat → Nat := (fun i => [4, 0, 1, 2, 3, 4].getD i 0)
theorem descending3 : InterleavedDescending model3 owner3 := by
  intro p i h
  have bound : i < 6 := eligible_lt _ _ _ h
  have cases : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl <;> simp [eligible, model3] at h
  all_goals subst p; decide
