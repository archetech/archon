def model4 : Model := ⟨8, (fun i => [some 4, some 5, some 4, some 1, some 4, some 3, some 4, some 5].getD i none), fun _ => true, (fun i => [0, 1, 0, 1, 2, 3].getD i 0)⟩
def owner4 : Nat → Nat := (fun i => [3, 4, 1, 0, 1, 2, 3, 4].getD i 0)
theorem descending4 : InterleavedDescending model4 owner4 := by
  intro p i h
  have bound : i < 8 := eligible_lt _ _ _ h
  have cases : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 ∨ i = 7 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [eligible, model4] at h
  all_goals subst p; decide
