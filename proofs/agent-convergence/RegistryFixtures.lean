  have xb : x < 17 := eligible_lt _ _ _ xv
  have yb : y < 17 := eligible_lt _ _ _ yv
  have finite : ∀ x y : Fin 17,
      eligible anchors3 (receipts3.owner x.val) x.val = true →
      eligible anchors3 (receipts3.owner y.val) y.val = true →
      receipts3.registry x.val = receipts3.registry y.val →
      (x.val < y.val ↔ compare (positions3 x.val) (positions3 y.val) = .lt) := by decide
  exact finite ⟨x, xb⟩ ⟨y, yb⟩ xv yv same
