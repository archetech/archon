def graph1 : RegistryGraph := {
  size := 7
  root := 4
  initial := 0
  parent := (fun i => [some 2, some 6, some 4, some 5, none, some 4, some 0].getD i (none))
  depth := (fun i => [2, 4, 1, 2, 0, 1, 3].getD i (0))
  change := (fun i => [none, none, some 2, none, none, some 1, some 0].getD i (none))
}
theorem ordered1 : RegistryOrdered graph1 := by
  intro i p parent
  by_cases bound : i < 7
  · have cases : i = 0 ∨ i = 1 ∨ i = 2 ∨ i = 3 ∨ i = 4 ∨ i = 5 ∨ i = 6 := by omega
    rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [graph1] at parent
    all_goals subst p; decide
  · have outside : 7 ≤ i := by omega
    simp only [graph1] at parent
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simpa using outside)] at parent
    simp at parent
