theorem depthBound3 : ∀ i, i < graph3.size → graph3.depth i < graph3.size := by
  have finite : ∀ i : Fin 7, graph3.depth i.val < graph3.size := by decide
  intro i bound
  exact finite ⟨i, bound⟩
