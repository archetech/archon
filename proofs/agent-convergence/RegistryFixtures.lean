theorem ordinalRanks2 : RegistryOrdinalRanks graph2 receipts2 positions2 := by
  intro x y xv yv same
  have xb : x < 16 := eligible_lt _ _ _ xv
  have yb : y < 16 := eligible_lt _ _ _ yv
  have finite : ∀ x y : Fin 16,
      eligible anchors2 (receipts2.owner x.val) x.val = true →
      eligible anchors2 (receipts2.owner y.val) y.val = true →
      receipts2.registry x.val = receipts2.registry y.val →
      (x.val < y.val ↔ compare (positions2 x.val) (positions2 y.val) = .lt) := by decide
  exact finite ⟨x, xb⟩ ⟨y, yb⟩ xv yv same
