def receipts2 : RegistryReceipts := {
  size := 7
  owner := (fun i => [4, 3, 1, 0, 2, 6, 5].getD i (7))
  registry := (fun i => [0, 0, 0, 0, 1, 2, 2].getD i (4))
  chain := (fun i => [true, true, true, false].getD i (false))
  accepted := fun i => decide (i < 7)
}
abbrev anchors2 := registryAnchors RegistryFixtures.graph2 receipts2
abbrev owner2 := chainOwner anchors2
abbrev priority2 := chainPriority anchors2 [0, 1, 2, 3, 4, 5, 6]
abbrev raw2 := registryEvents RegistryFixtures.graph2 anchors2
abbrev compiled2 := chainGraph (registryModel RegistryFixtures.graph2) anchors2 [0, 1, 2, 3, 4, 5, 6]
