def positions2 : Nat → List Nat := (fun i => [[100, 0, 0], [100, 2, 0], [100, 30, 0], [100, 50, 0], [100, 10, 0], [100, 500, 0], [100, 600, 0]].getD i ([]))
theorem ordinalRanks2 : RegistryOrdinalRanks RegistryFixtures.graph2 receipts2 positions2 := by
  intro x y xv yv same
  have xb : x < 7 := eligible_lt _ _ _ xv
  have yb : y < 7 := eligible_lt _ _ _ yv
  have finite : ∀ x y : Fin 7,
      eligible anchors2 (receipts2.owner x.val) x.val = true → eligible anchors2 (receipts2.owner y.val) y.val = true →
      receipts2.registry x.val = receipts2.registry y.val →
      (x.val < y.val ↔ compare (positions2 x.val) (positions2 y.val) = .lt) := by decide
  exact finite ⟨x, xb⟩ ⟨y, yb⟩ xv yv same
