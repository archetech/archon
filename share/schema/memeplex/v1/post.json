{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Memeplex post",
    "type": "object",
    "properties": {
        "v": {
            "const": 1
        },
        "author": {
            "$ref": "#/$defs/did"
        },
        "grant": {
            "$ref": "#/$defs/did"
        },
        "kind": {
            "const": "post"
        },
        "text": {
            "$ref": "#/$defs/text"
        },
        "content": {
            "$ref": "#/$defs/markdown"
        },
        "target": {
            "$ref": "#/$defs/did"
        },
        "targetVersion": {
            "$ref": "#/$defs/versionId"
        },
        "tags": {
            "$ref": "#/$defs/tags"
        },
        "title": {
            "type": "string",
            "maxLength": 300
        },
        "subtitle": {
            "type": "string",
            "maxLength": 300
        },
        "summary": {
            "type": "string",
            "maxLength": 5000
        },
        "firstPublished": {
            "$ref": "#/$defs/date"
        },
        "original": {
            "$ref": "#/$defs/link"
        },
        "authors": false,
        "source": false,
        "pdf": false,
        "verdict": false,
        "rating": false,
        "min": false,
        "max": false,
        "tag": false,
        "image": false
    },
    "required": [
        "v",
        "kind",
        "author",
        "grant"
    ],
    "dependentRequired": {
        "target": [
            "targetVersion"
        ],
        "targetVersion": [
            "target"
        ],
        "subtitle": [
            "title"
        ],
        "summary": [
            "title"
        ]
    },
    "allOf": [
        {
            "not": {
                "required": [
                    "text",
                    "content"
                ]
            }
        },
        {
            "anyOf": [
                {
                    "required": [
                        "text"
                    ]
                },
                {
                    "required": [
                        "content"
                    ]
                },
                {
                    "required": [
                        "target"
                    ]
                }
            ]
        }
    ],
    "$defs": {
        "did": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$"
        },
        "versionId": {
            "type": "string",
            "pattern": "^b[a-z2-7]{20,}$"
        },
        "cid": {
            "type": "string",
            "pattern": "^(b[a-z2-7]{20,}|Qm[1-9A-HJ-NP-Za-km-z]{44})$"
        },
        "bytes": {
            "type": "integer",
            "minimum": 0
        },
        "markdown": {
            "type": "object",
            "required": [
                "cid",
                "type",
                "bytes"
            ],
            "properties": {
                "cid": {
                    "$ref": "#/$defs/cid"
                },
                "type": {
                    "const": "text/markdown"
                },
                "bytes": {
                    "$ref": "#/$defs/bytes"
                }
            }
        },
        "tagValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
        },
        "tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
                "$ref": "#/$defs/tagValue"
            }
        },
        "text": {
            "type": "string",
            "maxLength": 10000
        },
        "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "link": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://[^\\s]+$"
        }
    }
}
