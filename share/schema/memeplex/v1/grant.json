{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Memeplex grant",
    "type": "object",
    "required": [
        "v",
        "client"
    ],
    "properties": {
        "v": {
            "const": 1
        },
        "client": {
            "$ref": "#/$defs/did"
        },
        "actions": {
            "$ref": "#/$defs/actions"
        },
        "nonce": {
            "$ref": "#/$defs/nonce"
        },
        "expiresAt": {
            "$ref": "#/$defs/expiresAt"
        }
    },
    "$defs": {
        "did": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$"
        },
        "pinnedDidUrl": {
            "type": "string",
            "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+\\?versionId=b[a-z2-7]{20,}$"
        },
        "action": {
            "anyOf": [
                {
                    "enum": [
                        "memeplex:post",
                        "memeplex:reply",
                        "memeplex:rate",
                        "memeplex:tag"
                    ]
                },
                {
                    "$ref": "#/$defs/pinnedDidUrl"
                }
            ]
        },
        "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "$ref": "#/$defs/action"
            }
        },
        "nonce": {
            "type": "string",
            "minLength": 22,
            "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expiresAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
    }
}
