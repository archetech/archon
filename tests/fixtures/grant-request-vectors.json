{
    "description": "The data of assets, and how each is read as a grant request: the app it names, with the member of the request that does not have the shape every request has when there is one, or null when the data holds no one request. Both Keymasters run it: tests/keymaster/grant.test.ts and python/keymaster/tests/test_grant.py.",
    "cases": [
        {
            "name": "the least a request holds",
            "data": {
                "exampleGrantRequest": {
                    "registries": [
                        "hyperswarm"
                    ]
                }
            },
            "expect": {
                "app": "example"
            }
        },
        {
            "name": "everything a request may hold",
            "data": {
                "exampleGrantRequest": {
                    "v": 1,
                    "name": "Example",
                    "registries": [
                        "BTC:mainnet",
                        "ETH:mainnet"
                    ],
                    "actions": [
                        "example:read",
                        "example:write"
                    ],
                    "expiresAt": "2028-02-29T23:59:59.5Z"
                }
            },
            "expect": {
                "app": "example"
            }
        },
        {
            "name": "another app",
            "data": {
                "memeplexGrantRequest": {
                    "v": 1,
                    "name": "Memepool",
                    "registries": [
                        "BTC:mainnet"
                    ]
                }
            },
            "expect": {
                "app": "memeplex"
            }
        },
        {
            "name": "an app named in mixed case with digits",
            "data": {
                "myApp2GrantRequest": {
                    "registries": [
                        "BTC:mainnet",
                        "ETH:mainnet"
                    ]
                }
            },
            "expect": {
                "app": "myApp2"
            }
        },
        {
            "name": "an app of one letter",
            "data": {
                "xGrantRequest": {
                    "registries": [
                        "BTC:mainnet",
                        "ETH:mainnet"
                    ]
                }
            },
            "expect": {
                "app": "x"
            }
        },
        {
            "name": "members of the request that are the app's",
            "data": {
                "exampleGrantRequest": {
                    "registries": [
                        "BTC:mainnet",
                        "ETH:mainnet"
                    ],
                    "client": 7,
                    "nonce": null,
                    "label": {
                        "deep": [
                            1
                        ]
                    }
                }
            },
            "expect": {
                "app": "example"
            }
        },
        {
            "name": "other members of the data",
            "data": {
                "exampleGrantRequest": {
                    "registries": [
                        "BTC:mainnet",
                        "ETH:mainnet"
                    ]
                },
                "note": "kept",
                "exampleGrant": {
                    "client": "did:cid:x"
                }
            },
            "expect": {
                "app": "example"
            }
        },
        {
            "name": "a registry of any name",
            "data": {
                "exampleGrantRequest": {
                    "registries": [
                        "local",
                        "my chain",
                        "BTC:signet"
                    ]
                }
            },
            "expect": {
                "app": "example"
            }
        },
