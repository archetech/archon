# Archon Noderunner — stage 0 (.env template)
# Placeholders {{LIKE_THIS}} are filled at install time; see SKILL.md
# "Filling the stage-0 template" for where each value comes from.

# --- Required: Gatekeeper and Keymaster refuse to start without these ---
ARCHON_UID={{UID}}
ARCHON_GID={{GID}}
ARCHON_ADMIN_API_KEY={{ADMIN_API_KEY}}
ARCHON_PASSPHRASE={{PASSPHRASE}}

# --- Identity ---
# ARCHON_NODE_ID names the node's agent in its wallet. It is fixed once the
# node first starts: changing it later creates a new agent.
ARCHON_NODE_NAME={{NODE_NAME}}
ARCHON_NODE_ID={{NODE_ID}}

# --- Installer metadata: read by this skill's scripts, not by Archon ---
ARCHON_HOSTNAME={{DOMAIN}}
ARCHON_ADMIN_EMAIL={{ADMIN_EMAIL}}

# --- Registries: stage 0 = hyperswarm only ---
ARCHON_GATEKEEPER_REGISTRIES=hyperswarm

# --- Fallback resolution: delegate to upstream Archon ---
ARCHON_GATEKEEPER_FALLBACK_URL={{UPSTREAM_URL}}
ARCHON_GATEKEEPER_CONFIRM_FALLBACK_URL={{UPSTREAM_URL}}

# --- Storage ---
ARCHON_GATEKEEPER_DB=redis
ARCHON_KEYMASTER_DB=redis

# --- Compose profiles ---
# Stage 0: minimal delegate node. add-* subcommands append to this list.
# Notably absent:
#   - drawbridge  (the front-door proxy; added by add-lightning. The services
#                  it fronts are independent profiles: lightning,
#                  herald (add-email), tor (opt-in).
#                  See stages/add-lightning.md)
#   - gatekeeper-client / keymaster-client  (admin/dev SPAs, not required at
#                  runtime; per operator preference, admin UIs should be
#                  Tailscale-only. Enable manually by appending to this list
#                  and exposing only on the private overlay.)
COMPOSE_PROFILES=hyperswarm,react-wallet

# --- Set by later stages ---
# ARCHON_PIN_PROVIDER=          (add-pinning)
# ARCHON_PIN_API_URL=           (add-pinning)
# ARCHON_PIN_API_TOKEN=         (add-pinning)
# ARCHON_HERALD_SESSION_SECRET= (add-email)
