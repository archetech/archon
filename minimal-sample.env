# Every variable docker/compose/minimal.yml requires, and nothing else.
#
#   docker compose --env-file .env -f docker/compose/minimal.yml up
#
# minimal.yml starts core, gatekeeper, keymaster and the hyperswarm mediator.
# These are the variables those fragments interpolate without a default, so
# leaving one out substitutes an empty string rather than failing.
#
# sample.env is the counterpart for a full node: it covers Lightning, Tor, the
# chain mediators, Herald, Drawbridge and observability, none of which this
# stack starts.

# hyperswarm-mediator is profile-gated, so without this the stack starts but
# nothing services the registry the gatekeeper is configured to use below.
COMPOSE_PROFILES=hyperswarm

# This node's identity on the hyperswarm network
ARCHON_NODE_ID=mynodeID
ARCHON_NODE_NAME=mynodeName
ARCHON_PROTOCOL=/ARCHON/v0.8-beta
ARCHON_HYPR_EXPORT_INTERVAL=2

# File ownership inside the containers; match the host user that owns ./data
ARCHON_UID=1000
ARCHON_GID=1000

# Gatekeeper
ARCHON_GATEKEEPER_PORT=4224
ARCHON_GATEKEEPER_DB=redis
ARCHON_GATEKEEPER_DID_PREFIX=did:cid
ARCHON_GATEKEEPER_REGISTRIES=hyperswarm
ARCHON_GATEKEEPER_REGISTRIES_PIN=
ARCHON_GATEKEEPER_GC_INTERVAL=60
ARCHON_GATEKEEPER_STATUS_INTERVAL=1
ARCHON_GATEKEEPER_UPLOAD_LIMIT=10mb
ARCHON_GATEKEEPER_FALLBACK_URL=https://dev.uniresolver.io
ARCHON_GATEKEEPER_FALLBACK_TIMEOUT=5000
ARCHON_GATEKEEPER_CONFIRM_FALLBACK_URL=

# Keymaster
ARCHON_KEYMASTER_DB=json
ARCHON_KEYMASTER_UPLOAD_LIMIT=10mb
ARCHON_WALLET_CACHE=false
ARCHON_DEFAULT_REGISTRY=hyperswarm
ARCHON_ENCRYPTED_PASSPHRASE=

# Blank disables the admin API
ARCHON_ADMIN_API_KEY=
