# Every variable docker/compose/minimal.yml requires, and nothing else. Anything
# else those fragments read carries a compose default.
#
#   cp minimal-sample.env .env
#   docker compose --env-file .env -f docker/compose/minimal.yml up
#
# sample.env is the counterpart for a full node.

# hyperswarm-mediator is profile-gated; without this nothing services the
# registry configured below.
COMPOSE_PROFILES=hyperswarm

# This node's identity on the hyperswarm network, and how often it exports to
# peers, in minutes.
ARCHON_NODE_ID=mynodeID
ARCHON_NODE_NAME=mynodeName
ARCHON_HYPR_EXPORT_INTERVAL=2

# Match the host user that owns ./data.
ARCHON_UID=1000
ARCHON_GID=1000

# Registries this node accepts DIDs on, and the one it publishes to by default.
ARCHON_GATEKEEPER_REGISTRIES=hyperswarm
ARCHON_DEFAULT_REGISTRY=hyperswarm

# Peer Gatekeeper consulted when confirm=true resolution is unconfirmed locally.
ARCHON_GATEKEEPER_CONFIRM_FALLBACK_URL=https://archon.technology

# Encrypts the wallet mnemonic. Set it before the wallet is created.
ARCHON_ENCRYPTED_PASSPHRASE=CHANGE_ME

# Gates the admin routes, and the mediators authenticate with it. Replace it:
# under 32 characters the gatekeeper warns on every boot.
#
#   openssl rand -hex 32
ARCHON_ADMIN_API_KEY=CHANGE_ME
