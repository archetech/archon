# Every variable docker/compose/minimal.yml requires, and nothing else.
#
#   cp minimal-sample.env .env
#   docker compose --env-file .env -f docker/compose/minimal.yml up
#
# minimal.yml starts core, gatekeeper, keymaster and the hyperswarm mediator.
# Everything else those fragments read carries a compose default; these are the
# ones left to the operator, either because they identify this node or because
# no default would be right for every node.
#
# sample.env is the counterpart for a full node: it covers Lightning, Tor, the
# chain mediators, Herald, Drawbridge and observability, none of which this
# stack starts.

# hyperswarm-mediator is profile-gated, so without this the stack starts but
# nothing services the registry the gatekeeper is configured to use below.
COMPOSE_PROFILES=hyperswarm

# This node's identity on the hyperswarm network. The mediator falls back to an
# empty id and the name "anon", so leaving these makes the node anonymous
# rather than broken.
ARCHON_NODE_ID=mynodeID
ARCHON_NODE_NAME=mynodeName

# How often the mediator exports to peers, in minutes.
ARCHON_HYPR_EXPORT_INTERVAL=2

# File ownership inside the containers; match the host user that owns ./data.
ARCHON_UID=1000
ARCHON_GID=1000

# Which registries this node accepts DIDs on, and which one it publishes to by
# default. minimal.yml only starts the hyperswarm mediator, so naming a
# registry here that nothing services would leave DIDs unpublished.
ARCHON_GATEKEEPER_REGISTRIES=hyperswarm
ARCHON_DEFAULT_REGISTRY=hyperswarm

# A peer Gatekeeper, consulted when confirm=true resolution is unconfirmed
# locally. It takes an Archon node rather than a universal resolver, and is
# only ever asked about this node's own method.
ARCHON_GATEKEEPER_CONFIRM_FALLBACK_URL=https://archon.technology

# Encrypts the wallet mnemonic. The keymaster constructor rejects an empty
# value, so this is required rather than optional. Set it before the wallet is
# created: changing it afterwards has to re-encrypt the existing wallet.
ARCHON_ENCRYPTED_PASSPHRASE=CHANGE_ME

# Gates db/reset, dids/remove and batch import/export, and the mediators
# authenticate to those routes with it. The gatekeeper refuses to start when it
# is empty; under 32 characters it starts and warns on every boot, so this
# placeholder nags until it is replaced:
#
#   openssl rand -hex 32
ARCHON_ADMIN_API_KEY=CHANGE_ME
